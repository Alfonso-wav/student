{
  "name": "student",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:content": "vitest run src/content.test.ts",
    "tts": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/tts.ts",
    "images": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/images.ts",
    "build:android": "tsc --noEmit && cross-env BASE=/ NATIVE=1 vite build && cap sync android",
    "apk": "npm run build:android && cd android && .\\gradlew.bat assembleDebug && copy /Y app\\build\\outputs\\apk\\debug\\app-debug.apk ..\\Student.apk"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
